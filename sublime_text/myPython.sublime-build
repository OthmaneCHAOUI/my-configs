{
    "target": "terminus_exec",
    "cancel": "terminus_cancel_build",
    "focus": true,
    // "shell": true,
    // "timeit": true,
    
    // for the directery
    // "cmd": ["python", "-u", "$file"],
    // "file_regex": "^[ ]*File \"(...*?)\", line ([0-9]*)",
    // "selector": "source.python",
    // "shell": true,
    // "working_dir": "${file_path}",
    // //

    "working_dir": "${file_path}", // for the directory



    "cmd": ["python3", "-u", "$file"],
    "file_regex": "^[ ]*File \"(...*?)\", line ([0-9]*)",
    "selector": "source.py",

    "env": {"PYTHONIOENCODING": "utf-8"},

    "windows": {
        "cmd": ["python", "-u", "$file"],
    },

    "variants":
    [
        {
            "name": "Syntax Check",
            "cmd": ["python3", "-m", "py_compile", "$file"],

            "windows": {
                "cmd": ["py", "-m", "py_compile", "$file"],
            }
        }
    ],
}
